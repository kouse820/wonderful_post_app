<p id="notice"><%= notice %></p>

<h1>マイページ</h1>
<%= render partial: "search" %>
<%= link_to '記事作成', new_article_path, class: "btn btn-info mb-2" %>

<table class="table">
  <thead>
    <tr>
      <th scope="col">タイトル</th>
      <th scope="col">内容</th>
      <th scope="col">タグ</th>
      <th scope="col"></th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.title %></td>
        <td><%= article.content %></td>
        <td><%= article.tags.map(&:name).join(', ') %></td>
        <td>
          <%= link_to '詳細', article, class: "btn btn-success btn-sm" %>
          <%= link_to '編集', edit_article_path(article), class: "btn btn-warning btn-sm" %>
          <%= button_to '削除', article, class: "btn btn-danger btn-sm", method: :delete, form: { data: { turbo_confirm: '本当に削除しますか？' } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @articles %>

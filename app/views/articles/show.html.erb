<p id="notice"><%= notice %></p>

<div class="card mb-3">
  <div class="card-header">
    <%= @article.title %>
  </div>
  <div class="card-body">
    <p><%= @article.content %></p>
    <p>タグ: <%= @article.tags.map(&:name).join(', ') %></p>
  </div>
</div>

<%= link_to '一覧', articles_path, class: "btn btn-secondary" %>
<% if user_signed_in? && current_user == @article.user %>
  <%= link_to '編集', edit_article_path(@article), class: "btn btn-warning" %>
  <%= button_to '削除', @article, class: "btn btn-danger", method: :delete, form: { data: { turbo_confirm: '本当に削除しますか？' } } %>
<% end %>

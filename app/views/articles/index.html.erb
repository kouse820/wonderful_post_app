<p id="notice"><%= notice %></p>

<h1>記事一覧</h1>
<%= render partial: "search" %>

<table class="table">
  <thead>
    <tr>
      <th scope="col">タイトル</th>
      <th scope="col">内容</th>
      <th scope="col">タグ</th>
      <th scope="col"></th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.title %></td>
        <td><%= article.content %></td>
        <td><%= article.tags.map(&:name).join(', ') %></td>
        <td>
          <%= link_to '詳細', article, class: "btn btn-success btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @articles %>
